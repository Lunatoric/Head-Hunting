<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= rows.boss_name%></title><link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@100..900&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="css/ejsstyle.css">
        <script type="module" src='background.js'></script>
        <link rel="stylesheet" href="css/sidebar.css">
    </head>

    <body>
        <article class="sidebar">
            <a href="/" title="Home Page"><img src="Images/Favicon.png" class="homeicon"></a>
            <a href="/bosseskilled?pagenum=1" title="Bosses Killed"><img src="Images/DeadSkull.png" class="standardicon"></a>
            <a href="/bossesalive?pagenum=1" title="Bosses to Kill"><img src="Images/AliveSkull.png" class="standardicon"></a>
            <a href="/gamedirectory?pagenum=1" title="Game List"><img src="Images/Controller.png" class="standardicon"></a>
        </article>
        <div class="outerdiv">
            <div class="horizontaldiv"> <!-- Top Double -->
                <article class="topdivleft"> <!-- The Name and Game -->
                    <h3>Boss Name</h3>
                    <h1><%= rows.boss_name%></h1> <!-- The < %= used here is for ejs, and allows for dynamic pages-->
                    <h4>From</h4> 
                    <h2><%= rows.game%></h2>
                </article>
                <div class="topdivright"> <!-- The Image -->
                    <img src="<%= rows.image %>" class="boss">
                </div>
            </div>
            <div class="horizontaldiv"> <!-- Middle Double -->
                <div class="bigdiv"> <!-- About section -->
                    <div class="slamleftdiv">
                        <h2>A little about this boss</h2>
                    </div>
                    <h5><%= rows.about%></h5>
                </div>
                <div class="smalldiv"> <!-- Rating and difficulty -->
                    <div class="slamleftdiv">
                        <h3>Rating</h3>
                    </div>
                    <div id="ratingstars" class="diffandrating">
                        <% for (let i = 0; i < rows.rating; i++) { %>
                            <img src="/Images/starfull.png">
                        <% } %>
                        <% for (let i = 0; i < 5-rows.rating; i++) { %>
                            <img src="/Images/starempty.png">
                        <% } %>
                    </div>
                    <div class="slamleftdiv">
                        <h3>Difficulty</h3>
                    </div>
                    <div id="diffskulls" class="diffandrating">
                        <% for (let i = 0; i < rows.difficulty; i++) { %>
                            <img src="/Images/skullfull.png">
                        <% } %>
                        <% for (let i = 0; i < 5-rows.difficulty; i++) { %>
                            <img src="/Images/skullempty.png">
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="horizontaldiv"> <!-- Bottom Double -->
                <div id="killedbox" class="smalldiv"> <!-- Is the boss Dead? -->
                    <h3>Have you<br>Killed it?</h3>
                    <% switch(rows.Killed) { case '1' : %>
                            <h5>The triumph is strong, be proud and kill more</h5>
                            <% break; case '0' : %>
                            <button type="button" id="killedbossbtn" onclick="bosskill('<%= rows.boss_name %>')"> Click Once Killed </button>
                            <script>
                                function bosskill(boss) {
                                    fetch('/api/bosskilled', {
                                        method : 'PUT',
                                        headers: {'Content-Type' : 'application/json'},
                                        body   : JSON.stringify({bossName : boss})
                                    });
                                };
                            </script>
                            <% break; } %>
                </div>
                <div class="bigdiv"> <!-- The Wiki Page :O -->
                    <h3>Dedicated Wiki Found</h3>
                    <a href="<%=rows.website%>" target="_blank"><h6>Here</h6></a>
                </div>
            </div>
        </div>
    </body>
</html>
